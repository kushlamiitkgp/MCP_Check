# ── Twilio credentials ─────────────────────────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio WhatsApp sandbox number (or your approved sender)
# Sandbox default: +14155238886
TWILIO_WHATSAPP_FROM=+14155238886

# Optional: comma-separated list of numbers you are allowed to message.
# Leave empty to allow any number.
# Format: E.164  e.g.  +919876543210,+14081234567
ALLOWED_NUMBERS=+919876543210,+14081234567
